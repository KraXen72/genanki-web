{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vocabulary starter",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1
    },
    "template": {
      "const": "vocabulary-starter"
    },
    "template_version": {
      "const": 1
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "examples": ["ru:книга"]
          },
          "source": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^(?!.*::)[^\\x00-\\x1f]*$",
            "examples": ["Lesson 1"]
          },
          "word": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "examples": ["кни́га"]
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "examples": ["book"]
          },
          "example": {
            "type": "string",
            "maxLength": 4000,
            "examples": ["Э́то моя́ кни́га.\nThis is my book."]
          }
        },
        "required": ["id", "word", "meaning"],
        "additionalProperties": false
      }
    }
  },
  "required": ["format_version", "template", "template_version", "notes"],
  "additionalProperties": false
}
