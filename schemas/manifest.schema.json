{
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "input_version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^[a-zA-Z0-9_/.-]+\\.[a-z]+$"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^[a-zA-Z0-9_/.-]+\\.[a-z]+$"
    },
    "css": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^[a-zA-Z0-9_/.-]+\\.[a-z]+$"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z0-9_]+)*$"
          },
          "format": {
            "enum": ["text", "lines", "list", "label"]
          },
          "labels": {
            "type": "object",
            "maxProperties": 64,
            "additionalProperties": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "item_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          }
        },
        "required": ["name", "path", "format"],
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "^\\S+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z0-9_]+)*$"
          }
        },
        "required": ["prefix", "path"],
        "additionalProperties": false
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "front": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "^[a-zA-Z0-9_/.-]+\\.[a-z]+$"
          },
          "back": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "^[a-zA-Z0-9_/.-]+\\.[a-z]+$"
          }
        },
        "required": ["name", "front", "back"],
        "additionalProperties": false
      }
    },
    "destination": {
      "type": "object",
      "properties": {
        "policy": {
          "enum": ["fixed", "shared-source"]
        },
        "deck": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": ["policy", "deck"],
      "additionalProperties": false
    },
    "validators": {
      "description": "Optional content checks reading raw values of the named fields. Dictionary facts can block export.",
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "enum": ["ru-stress", "ru-aspect"]
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        "required": ["name", "fields"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format_version",
    "key",
    "input_version",
    "name",
    "model",
    "schema",
    "prompt",
    "css",
    "fields",
    "cards",
    "destination"
  ],
  "additionalProperties": false,
  "title": "PackManifest"
}
