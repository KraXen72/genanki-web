{
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1,
      "examples": [
        1
      ]
    },
    "template": {
      "const": "basic"
    },
    "template_version": {
      "const": 1
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "examples": [
              "study:photosynthesis"
            ]
          },
          "source": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^(?!.*::)[^\\x00-\\x1f]*$",
            "examples": [
              "Lesson 1"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "examples": [
              "What powers photosynthesis?"
            ]
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "examples": [
              "Sunlight."
            ]
          }
        },
        "required": [
          "id",
          "question",
          "answer"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format_version",
    "template",
    "template_version",
    "notes"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Question & answer"
}
