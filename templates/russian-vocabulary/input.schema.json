{
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1,
      "examples": [
        1
      ]
    },
    "template": {
      "const": "russian-vocabulary"
    },
    "template_version": {
      "const": 2
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "examples": [
              "ru:делать:general"
            ]
          },
          "source": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^(?!.*::)[^\\x00-\\x1f]*$",
            "examples": [
              "Lesson 1"
            ]
          },
          "kind": {
            "type": "string",
            "maxLength": 4000,
            "pattern": "^(?![\\s\\S]*(?:—|<|>|\\{\\{|\\}\\}|\\[sound:))[\\s\\S]*$",
            "enum": [
              "pod.m:m",
              "pod.m:ž",
              "pod.m:s",
              "pod.m:oboj",
              "pod.m:pomn",
              "príd.m",
              "slov",
              "prís",
              "zám",
              "čísl",
              "spoj",
              "pred",
              "čast",
              "cito",
              "fráza"
            ],
            "examples": [
              "slov"
            ]
          },
          "aspect": {
            "type": "string",
            "maxLength": 4000,
            "pattern": "^(?![\\s\\S]*(?:—|<|>|\\{\\{|\\}\\}|\\[sound:))[\\s\\S]*$",
            "enum": [
              "impf",
              "pf",
              "both"
            ],
            "examples": [
              "impf"
            ],
            "description": "Required for kind = slov; forbidden for other kinds."
          },
          "partner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "^(?![\\s\\S]*(?:—|<|>|\\{\\{|\\}\\}|\\[sound:))[\\s\\S]*$",
            "examples": [
              "сде́лать"
            ],
            "description": "Stressed aspect partners, comma-separated. Verbs only."
          },
          "motion": {
            "type": "string",
            "maxLength": 4000,
            "pattern": "^(?![\\s\\S]*(?:—|<|>|\\{\\{|\\}\\}|\\[sound:))[\\s\\S]*$",
            "enum": [
              "unidir",
              "multidir"
            ],
            "description": "Only for the 14 unprefixed paired verbs of motion. Omit for other verbs."
          },
          "usage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "^(?![\\s\\S]*(?:—|<|>|\\{\\{|\\}\\}|\\[sound:))[\\s\\S]*$",
            "examples": [
              "hovorové"
            ],
            "description": "Optional Slovak register or usage labels."
          },
          "word": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "^(?![\\s\\S]*(?:—|<|>|\\{\\{|\\}\\}|\\[sound:))[\\s\\S]*$",
            "examples": [
              "де́лать"
            ]
          },
          "meanings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "sk": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "^(?![\\s\\S]*(?:—|<|>|\\{\\{|\\}\\}|\\[sound:))[\\s\\S]*$",
                  "examples": [
                    "robiť"
                  ]
                },
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "^(?![\\s\\S]*(?:—|<|>|\\{\\{|\\}\\}|\\[sound:))[\\s\\S]*$",
                  "examples": [
                    "to do, to make"
                  ]
                },
                "sentence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "^(?![\\s\\S]*(?:—|<|>|\\{\\{|\\}\\}|\\[sound:))[\\s\\S]*$",
                  "examples": [
                    "Я де́лаю э́то сам."
                  ]
                },
                "translation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "^(?![\\s\\S]*(?:—|<|>|\\{\\{|\\}\\}|\\[sound:))[\\s\\S]*$",
                  "examples": [
                    "Robím to sám."
                  ]
                }
              },
              "required": [
                "sk",
                "en"
              ],
              "additionalProperties": false,
              "dependencies": {
                "sentence": [
                  "translation"
                ],
                "translation": [
                  "sentence"
                ]
              }
            }
          }
        },
        "required": [
          "id",
          "kind",
          "word",
          "meanings"
        ],
        "additionalProperties": false,
        "dependencies": {
          "partner": [
            "aspect"
          ],
          "motion": [
            "aspect"
          ]
        },
        "examples": [
          {
            "id": "ru:делать:general",
            "source": "Lesson 1",
            "kind": "slov",
            "aspect": "impf",
            "partner": "сде́лать",
            "word": "де́лать",
            "meanings": [
              {
                "sk": "robiť",
                "en": "to do, to make",
                "sentence": "Я де́лаю э́то сам.",
                "translation": "Robím to sám."
              }
            ]
          }
        ]
      }
    }
  },
  "required": [
    "format_version",
    "template",
    "template_version",
    "notes"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Russian vocabulary"
}
