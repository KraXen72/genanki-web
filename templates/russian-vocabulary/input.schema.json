{
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1,
      "examples": [
        1
      ]
    },
    "template": {
      "const": "russian-vocabulary"
    },
    "template_version": {
      "const": 1
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "examples": [
              "ru:книга:general"
            ]
          },
          "source": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^(?!.*::)[^\\x00-\\x1f]*$",
            "examples": [
              "Lesson 1"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "^(?![\\s\\S]*(?:—|<|>|\\{\\{|\\}\\}|\\[sound:))[\\s\\S]*$",
            "examples": [
              "podstatné meno; ženský rod"
            ]
          },
          "word": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "^(?![\\s\\S]*(?:—|<|>|\\{\\{|\\}\\}|\\[sound:))[\\s\\S]*$",
            "examples": [
              "кни́га"
            ]
          },
          "meanings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "sk": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "^(?![\\s\\S]*(?:—|<|>|\\{\\{|\\}\\}|\\[sound:))[\\s\\S]*$",
                  "examples": [
                    "kniha"
                  ]
                },
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "^(?![\\s\\S]*(?:—|<|>|\\{\\{|\\}\\}|\\[sound:))[\\s\\S]*$",
                  "examples": [
                    "book"
                  ]
                },
                "sentence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "^(?![\\s\\S]*(?:—|<|>|\\{\\{|\\}\\}|\\[sound:))[\\s\\S]*$",
                  "examples": [
                    "Э́то моя́ кни́га."
                  ]
                },
                "translation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "^(?![\\s\\S]*(?:—|<|>|\\{\\{|\\}\\}|\\[sound:))[\\s\\S]*$",
                  "examples": [
                    "Toto je moja kniha."
                  ]
                }
              },
              "required": [
                "sk",
                "en"
              ],
              "additionalProperties": false,
              "dependencies": {
                "sentence": [
                  "translation"
                ],
                "translation": [
                  "sentence"
                ]
              }
            }
          }
        },
        "required": [
          "id",
          "category",
          "word",
          "meanings"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format_version",
    "template",
    "template_version",
    "notes"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Russian vocabulary"
}
